# Copy this file to ".env" (same folder) and paste your keys after the = sign.
# Never share or commit the .env file.

# Slack → your app → OAuth & Permissions → "User OAuth Token" (starts with xoxp-)
SLACK_USER_TOKEN=

# Slack → your app → Basic Information → App Credentials → "Signing Secret"
SLACK_SIGNING_SECRET=

# Optional: Claude API key from https://console.anthropic.com (enables AI ranking and drafting)
ANTHROPIC_API_KEY=
